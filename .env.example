AWS_REGION=us-east-1
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::<account-id>:role/GitHubActionsBluecoinsDeployRole
STACK_NAME=bluecoins-rag-updater
GOOGLE_DRIVE_FILE_ID=<google-drive-file-id>
PINECONE_INDEX_NAME=bluecoins-transactions

# Store these as GitHub Actions secrets; do not commit real credentials here.
GOOGLE_SERVICE_ACCOUNT_EMAIL=<service-account-email>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=<service-account-private-key>
PINECONE_API_KEY=<pinecone-api-key>
